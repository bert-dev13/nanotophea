# Firebase Web SDK (client). Do not commit real secrets to git if policy requires —
# NEXT_PUBLIC_* values are exposed to the browser by design for Firebase web apps.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server / scripts only (never expose to the browser)
# Path to Firebase service account JSON (default: ./service.json)
# GOOGLE_APPLICATION_CREDENTIALS=./service.json
