# Database Configuration (XAMPP MySQL/MariaDB)
# Server-side only (never expose database credentials to the browser)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nanotophea_db
# Optional URL format:
# DATABASE_URL=mysql://root:@localhost:3306/nanotophea_db

# Seed Admin Credentials (development/seed only)
NANOTOPHEA_ADMIN_EMAIL=admin@demo.com
NANOTOPHEA_ADMIN_PASSWORD=admin123

# Server-side only. Never prefix with NEXT_PUBLIC_ and never send this to the browser.
TOGETHER_API_KEY=

# Local AutoDock Vina worker.
# VINA_BIN=C:/projects/nanotophea/tools/vina/vina.exe
# DOCKING_PYTHON=C:/projects/nanotophea/.docking-venv/Scripts/python.exe

# Hosted ADMET-AI service. Server-side only. Never prefix these with NEXT_PUBLIC_.
# The browser calls /api/scientific/adme. Next.js calls this URL from the server.
# ADMET_API_URL=http://127.0.0.1:8000
# ADMET_API_KEY=
# ADMET_TIMEOUT_SECONDS=240
